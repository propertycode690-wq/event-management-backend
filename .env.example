# ==============================================================
# Ultimate Hound Club - Backend Environment Configuration Template
# ==============================================================

# Server Port (default: 5050)
PORT=5050

# Safe Local Development Mode (uses isolated local SQLite database):
# Set to 'true' to run locally without connecting to MySQL:
USE_LOCAL_SQLITE=true

# MySQL Database Configuration (for staging / production):
# In development, connections to remote Railway hosts are blocked by default.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_local_password_here
DB_NAME=club

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Clover Payment Gateway Configuration (Sandbox / Production)
CLOVER_MERCHANT_ID=your_clover_merchant_id_here
CLOVER_API_KEY=your_clover_api_key_here
CLOVER_ENVIRONMENT=sandbox
CLOVER_API_URL=https://scl-sandbox.dev.clover.com/v1
CLOVER_WEBHOOK_SECRET=your_clover_webhook_secret_here
CLOVER_APP_ID=your_clover_app_id_here

