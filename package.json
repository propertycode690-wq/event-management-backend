{
  "name": "nh-portal-backend",
  "version": "1.0.0",
  "description": "Express.js RESTful API backend for National Hunting Network Portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:local": "node scripts/start_local.js",
    "test": "node tests/integration.test.js",
    "prisma:generate": "npx --no-install prisma generate",
    "prisma:push": "npx --no-install prisma db push",
    "prisma:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.23.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@prisma/client": "^5.18.0",
    "prisma": "^5.18.0"
  }
}